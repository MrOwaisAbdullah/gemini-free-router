{
  "name": "gemini-free-router",
  "version": "0.1.0",
  "description": "Squeeze 100% out of Gemini's free tier - per-model RPM/RPD/TPM scheduling for a single API key",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gemini-free-router": "./bin/gfr.mjs"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "gemini",
    "gemini-api",
    "free-tier",
    "llm-router",
    "openai-compatible",
    "rate-limiting",
    "quota-management",
    "llm-proxy",
    "selfhosted"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
